+def get_mamba_prefill_checkpoint_position(
+    num_tokens: int,
+    hash_block_size: int,
+    drop_eagle_block: bool,
+) -> int:
+    """Return the reusable Mamba checkpoint boundary for a prefill.
+
+    Prefix-cache hits with EAGLE drop the last hash block. Export the Mamba
+    state at that same replay boundary so the attention and Mamba groups agree.
+    """
+    checkpoint_position = num_tokens // hash_block_size * hash_block_size
+    if drop_eagle_block:
+        checkpoint_position -= hash_block_size
+    return max(checkpoint_position, 0)
+
+
+def is_mamba_prefill_checkpoint_enabled(
+    mamba_cache_mode: str,
+    num_prefill_checkpoint_blocks: int,
+) -> bool:
+    """Whether the Mamba backend may export an internal prefill checkpoint."""
+    return mamba_cache_mode == "align" and num_prefill_checkpoint_blocks > 0
+
