+++ b/vllm/v1/kv_cache_interface.py
@@ -873,6 +873,76 @@ def is_uniform_with_collection(
         )
 
 
+def get_mamba_prefill_checkpoint_position(
+    num_tokens: int,
+    hash_block_size: int,
+    drop_eagle_block: bool,
+) -> int:
+    """Return the reusable Mamba checkpoint boundary for a prefill.
+
+    Prefix-cache hits with EAGLE drop the last hash block. Export the Mamba
+    state at that same replay boundary so the attention and Mamba groups agree.
+    """
+    checkpoint_position = num_tokens // hash_block_size * hash_block_size
+    if drop_eagle_block:
+        checkpoint_position -= hash_block_size
+    return max(checkpoint_position, 0)
+
+
+def is_mamba_prefill_checkpoint_enabled(
+    mamba_cache_mode: str,
+    num_prefill_checkpoint_blocks: int,
+) -> bool:
+    """Whether the Mamba backend may export an internal prefill checkpoint."""
+    return mamba_cache_mode == "align" and num_prefill_checkpoint_blocks > 0
+
+
+@dataclass(frozen=True)
+class MambaPrefillCheckpointInfo:
+    """Checkpoint boundary and its offset in the current model input.
+
+    ``offset`` is zero when this model input must not export a checkpoint.
+    ``position`` is still returned because the scheduler also uses the target
+    boundary to keep the final prefill chunk from starting past it.
+    """
+
+    position: int
+    offset: int
+
+    @property
+    def export_position(self) -> int:
+        """Absolute boundary to export, or zero when export is disabled."""
+        return self.position if self.offset else 0
+
+
+def get_mamba_prefill_checkpoint_info(
+    *,
+    prefill_end: int,
+    query_start: int,
+    query_end: int,
+    hash_block_size: int,
+    mamba_block_size: int,
+    drop_eagle_block: bool,
+) -> MambaPrefillCheckpointInfo:
+    """Resolve the reusable checkpoint for one prefill model input.
+
+    The caller must first verify that prefill checkpoints are enabled.
+    """
+    position = get_mamba_prefill_checkpoint_position(
+        prefill_end,
+        hash_block_size,
+        drop_eagle_block=drop_eagle_block,
+    )
+    offset = position - query_start
+    valid = (
+        query_end >= prefill_end
+        and query_start % mamba_block_size == 0
+        and query_start + mamba_block_size <= position
+        and 0 < offset < query_end - query_start
+    )
+    return MambaPrefillCheckpointInfo(position, offset if valid else 0)
+
