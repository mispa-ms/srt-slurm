diff --git a/vllm/v1/attention/ops/common.py b/vllm/v1/attention/ops/common.py
index 0701807ba9..c325ac6556 100644
--- a/vllm/v1/attention/ops/common.py
+++ b/vllm/v1/attention/ops/common.py
@@ -23,8 +23,19 @@ def mask_dcp_empty_shards_(
         raise ValueError("query_start_loc must contain one boundary per sequence")
 
     query_lens = query_start_loc[1:] - query_start_loc[:-1]
+    is_empty = seq_lens == 0
+    # A full CUDA graph replays at a captured batch size, so the decode region
+    # is padded out and `lse` has more rows than `query_start_loc` accounts for
+    # (e.g. 3 real decodes replayed on the size-4 graph). repeat_interleave
+    # requires output_size to equal the sum of repeats exactly and raises a
+    # device-side assert otherwise, which kills EngineCore. Carry the padding as
+    # one trailing segment; masking it is also what we want, since those rows
+    # hold no query and must not contribute to the DCP combine.
+    padding = lse.shape[0] - query_start_loc[-1]
+    query_lens = torch.cat([query_lens, padding.reshape(1)])
+    is_empty = torch.cat([is_empty, is_empty.new_ones(1)])
     empty_rows = torch.repeat_interleave(
-        seq_lens == 0,
+        is_empty,
         query_lens,
         output_size=lse.shape[0],
     )
