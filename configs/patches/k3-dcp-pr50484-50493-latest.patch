+    def _init_query_gather(
+        self,
+        num_heads: int,
+        head_dim: int,
+        dtype: torch.dtype,
+    ) -> Callable[[torch.Tensor], torch.Tensor]:
+        direct_workspace = get_direct_dcp_q_gather_workspace(
