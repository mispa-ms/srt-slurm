     """
 
+    supports_pp_aux_hidden_states: bool = False
+    """
+    A flag that indicates this model relays auxiliary hidden states across
+    pipeline-parallel stages, keeping EAGLE-3 style drafting correct when
+    ``pipeline_parallel_size > 1``.
+
+    Models leaving this ``False`` are rejected at startup under PP, because
+    aux states collected on earlier stages would otherwise be dropped and the
+    drafter would silently run on a partial feature set.
+    """
+
 
