--- a/vllm/distributed/kv_transfer/kv_connector/v1/nixl/tp_mapping.py
+++ b/vllm/distributed/kv_transfer/kv_connector/v1/nixl/tp_mapping.py
@@ -97,15 +97,36 @@
         attn_ranks = (start + np.sort(unique_idx)).tolist()
 
     if transfer_topology.is_mla and remote_dcp_size > local_dcp_size:
-        assert remote_dcp_size % local_dcp_size == 0
-        dcp_ratio = remote_dcp_size // local_dcp_size
-        tp_ratio = remote_tp_size // tp_size
-        assert tp_ratio == dcp_ratio, (
-            "NIXL DCP gather requires the remote/local DCP ratio to match "
-            "the remote/local TP ratio"
+        # MLA duplicates the latent KV across remote TP and shards it by token
+        # across remote DCP, so a local rank needs one remote rank per DCP
+        # shard -- and, because the latent is duplicated, it does not matter
+        # *which* rank carries a given shard.  The consumer side pairs them with
+        #     dcp_rank = remote_rank % remote_dcp_size
+        #     local_block_ids[i] = group[dcp_rank :: remote_dcp_size]
+        # (base_worker._map_dcp_attention_block_ids), so any run of
+        # ``remote_dcp_size`` consecutive remote ranks covers every residue.
+        #
+        # The previous form was ``range(tp_rank * dcp_ratio, ...)`` guarded by
+        # ``tp_ratio == dcp_ratio``.  That walks a *disjoint* window per local
+        # rank, which only stays in range when dcp_ratio <= tp_ratio, and only
+        # happened to be correct because the guard forced local TP to 1 (so
+        # tp_rank was always 0).  Disjoint windows are not what MLA needs.
+        #
+        # Picking the window by ``tp_rank`` spreads readers across the duplicate
+        # sets instead of pointing every local rank at ranks 0..D-1.  With one
+        # duplicate set (remote TP == remote DCP, e.g. TP8/DCP8) this reduces to
+        # range(0, D) -- byte-identical to the old behaviour at local TP 1.
+        assert local_dcp_size == 1, (
+            "NIXL DCP gather with remote DCP > local DCP requires local DCP=1; "
+            f"got local_dcp_size={local_dcp_size}"
         )
-        start = tp_rank * dcp_ratio
-        attn_ranks = list(range(start, start + dcp_ratio))
+        assert remote_tp_size % remote_dcp_size == 0, (
+            f"remote TP {remote_tp_size} is not a multiple of remote DCP "
+            f"{remote_dcp_size}; the shard-to-rank map is undefined"
+        )
+        duplicate_sets = remote_tp_size // remote_dcp_size
+        base = (tp_rank % duplicate_sets) * remote_dcp_size
+        attn_ranks = list(range(base, base + remote_dcp_size))
 
     # --- SSM source ranks ---
     has_ssm = any(_is_ssm_spec(t) for t in group_spec_types)
