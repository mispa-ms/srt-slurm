diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
index 2a3531b61b..3fc4ee7989 100644
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -147,6 +147,12 @@ if TYPE_CHECKING:
     from vllm.v1.worker.gpu_model_runner import GPUModelRunner
 
 
+# --- ppbub: accumulated PP recv wait for the current step, reset by the
+# worker once per execute_model. Module-global because the waiting object is
+# constructed per step and the reader is the Worker.
+_PPBUB_WAIT_MS = 0.0
+
+
 class AsyncIntermediateTensors(IntermediateTensors):
     """IntermediateTensors with lazy comm synchronization"""
 
@@ -164,6 +170,17 @@ class AsyncIntermediateTensors(IntermediateTensors):
     def wait_for_comm(self) -> None:
         if self._comm_waited:
             return
+        # --- ppbub: this block is the stage-N idle wait ---
+        import time as _ppbub_t
+        _ppbub_t0 = _ppbub_t.perf_counter()
+        try:
+            self._ppbub_inner()
+        finally:
+            global _PPBUB_WAIT_MS
+            _PPBUB_WAIT_MS += (_ppbub_t.perf_counter() - _ppbub_t0) * 1000.0
+        return
+
+    def _ppbub_inner(self) -> None:
         if self._comm_handles:
             for handle in self._comm_handles:
                 handle.wait()
@@ -1158,6 +1175,29 @@ class Worker(WorkerBase):
 
         intermediate_tensors = None
         forward_pass = scheduler_output.total_num_scheduled_tokens > 0
+
+        # --- ppbub: per-rank step cadence, and the wait the runner records ---
+        try:
+            import time as _t
+            from vllm.distributed import get_pp_group as _gpp
+            _now = _t.perf_counter()
+            _prev = getattr(self, "_ppbub_last", None)
+            self._ppbub_last = _now
+            _n = getattr(self, "_ppbub_n", 0)
+            self._ppbub_n = _n + 1
+            import vllm.v1.worker.gpu_worker as _gw
+            if _n % 50 == 0 and _prev is not None:
+                _step = (_now - _prev) * 1000.0
+                _wait = _gw._PPBUB_WAIT_MS
+                logger.info(
+                    "[ppbub] pp_rank=%d n=%d step_ms=%.1f wait_ms=%.1f wait_pct=%.1f",
+                    _gpp().rank_in_group, _n, _step, _wait,
+                    (100.0 * _wait / _step) if _step > 0 else 0.0,
+                )
+            # Reset every step so the sampled value belongs to the sampled step.
+            _gw._PPBUB_WAIT_MS = 0.0
+        except Exception as e:  # noqa: BLE001
+            logger.warning("[ppbub] worker instrumentation failed: %s", e)
         num_scheduled_tokens = scheduler_output.total_num_scheduled_tokens
         all_gather_tensors = {}
         compilation_config = self.vllm_config.compilation_config
