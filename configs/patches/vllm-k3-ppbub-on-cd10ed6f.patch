diff --git a/vllm/v1/worker/gpu_worker.py b/vllm/v1/worker/gpu_worker.py
index 2a3531b61b..5791d72bf5 100644
--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -1158,6 +1158,28 @@ class Worker(WorkerBase):
 
         intermediate_tensors = None
         forward_pass = scheduler_output.total_num_scheduled_tokens > 0
+
+        # --- ppbub: per-rank step cadence, and the wait the runner records ---
+        try:
+            import time as _t
+            from vllm.distributed import get_pp_group as _gpp
+            _now = _t.perf_counter()
+            _prev = getattr(self, "_ppbub_last", None)
+            self._ppbub_last = _now
+            _n = getattr(self, "_ppbub_n", 0)
+            self._ppbub_n = _n + 1
+            if _n % 50 == 0 and _prev is not None:
+                _step = (_now - _prev) * 1000.0
+                _wait = getattr(self.model_runner, "_ppbub_wait_ms", 0.0)
+                logger.info(
+                    "[ppbub] pp_rank=%d n=%d step_ms=%.1f wait_ms=%.1f wait_pct=%.1f",
+                    _gpp().rank_in_group, _n, _step, _wait,
+                    (100.0 * _wait / _step) if _step > 0 else 0.0,
+                )
+            # Reset every step so the sampled value belongs to the sampled step.
+            self.model_runner._ppbub_wait_ms = 0.0
+        except Exception as e:  # noqa: BLE001
+            logger.warning("[ppbub] worker instrumentation failed: %s", e)
         num_scheduled_tokens = scheduler_output.total_num_scheduled_tokens
         all_gather_tensors = {}
         compilation_config = self.vllm_config.compilation_config
