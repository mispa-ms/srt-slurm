+def _snap_cut_below(cut: int, regions: list[tuple[int, int, int]]) -> int:
+    """Largest offset ``<= cut`` that does not land inside a transfer block.
+
+    ``regions`` are ``(base, block_stride, num_blocks)``. NIXL resolves each
+    transfer descriptor -- one block -- inside a single registered range, so a
+    registration boundary may only fall on a block start. Block ``b`` of a
+    region starts at ``base + b * block_stride``, so snapping down to that
+    lattice is sufficient; regions are disjoint in practice, but the loop runs
+    to a fixed point in case a snap moves the cut back into an earlier one.
+    """
+    for _ in range(len(regions) + 1):
+        moved = False
+        for base, block_stride, num_blocks in regions:
+            if block_stride <= 0 or num_blocks <= 0:
+                continue
+            if base < cut < base + block_stride * num_blocks:
+                snapped = base + ((cut - base) // block_stride) * block_stride
+                if snapped < cut:
+                    cut = snapped
+                    moved = True
+        if not moved:
+            return cut
+    return cut
+
+
+def _split_registration_ranges(
+    registration: tuple[int, int, int, str],
+    regions: list[tuple[int, int, int]],
+    limit: int,
+) -> list[tuple[int, int, int, str]]:
+    """Split one backing allocation into registrations of at most ``limit``.
+
+    Returns NIXL registration tuples covering ``[base, base + nbytes)``
+    exactly, carrying the original device id and metadata. A chunk may exceed
+    ``limit`` when no block boundary is available inside the budget -- a single
+    block larger than ``limit`` -- because splitting a block across two
+    registrations would be worse than an oversized one.
+    """
+    base, nbytes, device_id, meta = registration
+    if limit <= 0 or nbytes <= limit:
+        return [registration]
+    out: list[tuple[int, int, int, str]] = []
+    start, end = base, base + nbytes
+    while end - start > limit:
+        cut = _snap_cut_below(start + limit, regions)
+        if cut <= start:
+            break
+        out.append((start, cut - start, device_id, meta))
+        start = cut
+    out.append((start, end - start, device_id, meta))
+    return out
+
