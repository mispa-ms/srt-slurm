+def _group_index_from_key(key: str) -> int:
+    """KV cache group encoded in a pool key, or -1 if the key predates it."""
+    for part in key.split("@"):
+        if part.startswith("group:"):
+            return int(part.removeprefix("group:"))
+    return -1
