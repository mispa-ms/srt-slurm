+def get_prefix_replay_checkpoint(
+    prefix_tokens: int,
+    alignment_tokens: int,
+    recompute_tokens: int,
+) -> int:
+    """Return the latest aligned checkpoint that leaves a replay suffix.
+
+    Args:
+        prefix_tokens: Number of prompt tokens available to support the
+            checkpoint.
+        alignment_tokens: Prefix-cache replay granularity.
+        recompute_tokens: Number of tokens that must execute after the
+            checkpoint.
+
+    Returns:
+        The latest replayable checkpoint, or zero if the suffix consumes the
+        available prefix.
+    """
+    replayable_tokens = max(prefix_tokens - recompute_tokens, 0)
+    return replayable_tokens // alignment_tokens * alignment_tokens
+
+
+def get_prompt_cache_checkpoints(
+    num_prompt_tokens: int,
+    alignment_tokens: int,
+    eagle_replay_tokens: int,
+) -> tuple[int, ...]:
+    """Return the latest and replay checkpoints produced by a prompt."""
+    latest_checkpoint = get_prefix_replay_checkpoint(
+        num_prompt_tokens,
+        alignment_tokens,
+        0,
+    )
+    replay_checkpoint = get_prefix_replay_checkpoint(
+        num_prompt_tokens,
+        alignment_tokens,
+        eagle_replay_tokens or 1,
+    )
+    return tuple(
+        checkpoint
+        for checkpoint in dict.fromkeys((latest_checkpoint, replay_checkpoint))
+        if checkpoint > 0
+    )
