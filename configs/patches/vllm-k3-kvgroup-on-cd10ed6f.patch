--- a/vllm/v1/core/kv_cache_utils.py
+++ b/vllm/v1/core/kv_cache_utils.py
@@ -1549,6 +1549,42 @@ def _get_kv_cache_groups_uniform_page_size(
         # layers while accommodating speculative decoding drafters that add
         # extra layers to one attention type.
         group_size = max_num_layers
+    # --- kvgroup: answer the FIXME above, behind a flag ---
+    # The min/max heuristic assumes an n:1 layer pattern. Kimi-K3 is 69 KDA and
+    # 24 MLA, and a DSpark drafter puts 5 more layers in the MLA bucket, so the
+    # buckets are 69 and 29: not within 1.5x, so group_size = 29 and the KDA
+    # bucket pads 69 -> 87, wasting 26.09% of the KV cache. group_size = 10
+    # costs 2 padding layers instead of 18.
+    #
+    # Off by default: the group count feeds the Mooncake key namespaces and the
+    # NIXL region layout, so both halves of a disagg pair must agree.
+    if os.environ.get("VLLM_KV_GROUP_MIN_PADDING", "0") == "1":
+        _kvg_cap = int(os.environ.get("VLLM_KV_GROUP_MAX_GROUPS", "16"))
+        _kvg_sizes = [len(layers) for layers in layer_buckets]
+
+        def _kvg_cost(g):
+            pad = sum((g - n % g) % g for n in _kvg_sizes)
+            groups = sum(-(-n // g) for n in _kvg_sizes)
+            return pad, groups
+
+        _kvg_old = group_size
+        _kvg_best = None
+        for _g in range(1, max_num_layers + 1):
+            _pad, _groups = _kvg_cost(_g)
+            if _groups > _kvg_cap:
+                continue
+            # Ties to the LARGER group size: same padding, fewer groups.
+            if _kvg_best is None or (_pad, -_g) < (_kvg_best[0], -_kvg_best[2]):
+                _kvg_best = (_pad, _groups, _g)
+        if _kvg_best is not None and _kvg_best[2] != _kvg_old:
+            logger.info(
+                "[kvgroup] buckets=%s group_size %d -> %d, padding %d -> %d "
+                "layers, groups %d -> %d",
+                _kvg_sizes, _kvg_old, _kvg_best[2],
+                _kvg_cost(_kvg_old)[0], _kvg_best[0],
+                _kvg_cost(_kvg_old)[1], _kvg_best[1],
+            )
+            group_size = _kvg_best[2]
     grouped_layers = []
     for layers in layer_buckets:
         num_padding_layers = group_size - len(layers) % group_size
