+        a2_scale = self.w2_input_scale.max().to(torch.float32)
+        if ep_group.world_size > 1:
+            torch.distributed.all_reduce(
+                a13_scale,
+                op=torch.distributed.ReduceOp.MAX,
+                group=ep_group.device_group,
+            )
+            torch.distributed.all_reduce(
+                a2_scale,
+                op=torch.distributed.ReduceOp.MAX,
+                group=ep_group.device_group,
+            )
