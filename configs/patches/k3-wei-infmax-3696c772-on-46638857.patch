+            intermediate_size=self.intermediate_size,
+            top_k=self.top_k,
+            activation=self.activation,
+            situ_beta=self.activation_beta,
+            situ_linear_beta=self.activation_linear_beta,
+            input_norm_const=float((1.0 / a13_scale).item()),
