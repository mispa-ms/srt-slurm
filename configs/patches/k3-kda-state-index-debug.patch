             batch_ptr=batch_ptr,
             token_chunk_offset_ptr=token_chunk_offset_ptr,
         )
+        if _KDA_IDX_DEBUG:
+            # The kda.py check needs the inputs _get_aligned_state_indices_kernel
+            # derived the slot from; none of them survive on the metadata.
+            md.dbg_seq_lens = m.seq_lens
+            md.dbg_cache_block_size = self.kv_cache_spec.block_size
+            md.dbg_raw_block_table = m.block_table_tensor
+            md.dbg_raw_block_table_width = m.block_table_tensor.shape[1]
+            self._dbg_log_sizing_once(m)
+        return md
+
+    def _dbg_log_sizing_once(self, m) -> None:
+        """One line naming every input that decides the block-table width.
+
+        The width the builder receives (86 at DCP=8) does not match
+        cdiv(max_model_len, spec.block_size) = 683, which is what
+        MambaSpec.max_num_blocks_per_req returns in align mode -- and the slot
+        the Triton kernel reads is derived from spec.block_size. Whichever of
+        these disagrees is the defect; printing them all settles it without
+        another round of source reading.
+        """
+        if getattr(self, "_dbg_logged", False):
+            return
+        self._dbg_logged = True
+        import logging
+
+        spec = self.kv_cache_spec
+        cfg = self.vllm_config
+        cc = cfg.cache_config
+        max_len = cfg.model_config.max_model_len
+        try:
+            computed = spec.max_num_blocks_per_req(cfg, max_len)
+        except Exception as exc:  # noqa: BLE001
+            computed = f"raised {exc!r}"
+        logging.getLogger("vllm.models.kimi_k3.nvidia.kda_metadata").error(
+            "KDA-IDX sizing: spec=%s spec.block_size=%s spec.num_spec_blocks=%s "
+            "spec.mamba_cache_mode=%s spec.page_size_bytes=%s | "
+            "cache_config.block_size=%s cache_config.mamba_cache_mode=%s | "
+            "max_model_len=%s dcp=%s | "
+            "spec.max_num_blocks_per_req=%s  ACTUAL_bt_width=%s | "
+            "cdiv(max_len, spec.block_size)=%s cdiv(max_len, spec.block_size*dcp)=%s",
+            type(spec).__name__, spec.block_size,
+            getattr(spec, "num_speculative_blocks", None),
+            getattr(spec, "mamba_cache_mode", None), spec.page_size_bytes,
+            cc.block_size, cc.mamba_cache_mode, max_len,
+            cfg.parallel_config.decode_context_parallel_size,
+            computed, m.block_table_tensor.shape[1],
+            -(-max_len // spec.block_size),
+            -(-max_len // (spec.block_size
+                           * cfg.parallel_config.decode_context_parallel_size)),
+        )
 
 
