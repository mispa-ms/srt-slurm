+    def _stage_layer_layout(
+        self, nixl_agent_meta: NixlAgentMetadata
+    ) -> StageLayout | None:
+        """One PP peer stage's layer layout: group ids and the kind split.
+
+        Descriptor ids for that stage must be computed over its layer list, not
+        ours. The groups come from our own KV cache config -- the peers run the
+        same model, so a layer's group is the same on both sides.
+        """
+        if self._local_regions_for_remote_layers(nixl_agent_meta) is None:
+            return None
+        group_by_layer = self.kv_cache_config.transfer_group_index_by_layer
+        group_ids = tuple(
+            group_by_layer[name]
+            for names in nixl_agent_meta.region_members
+            for name in names
+        )
+        attention = tuple(
+            k
+            for k, g in enumerate(group_ids)
+            if not _is_ssm_spec(self._group_spec_types[g])
+        )
+        ssm = tuple(
+            k
+            for k, g in enumerate(group_ids)
+            if _is_ssm_spec(self._group_spec_types[g])
+        )
+        return group_ids, attention, ssm
+
+    def _stage_emission_lists(
+        self, nixl_agent_meta: NixlAgentMetadata
+    ) -> tuple[list[int], list[int]] | None:
+        """Local FA and SSM emission lists mirroring one stage of a PP peer.
+
+        A layer-routing peer lays its descriptors out layer-major --
+        ``[FA per attention layer | conv + temporal per SSM layer]`` -- so an
+        unsharded producer writing into that stage has to emit the same runs in
+        the same order. Returns the two lists of local region indices, or
+        ``None`` when the peer holds everything and the existing paths apply.
+
+        A pooled region appears once per layer it backs, which is why the
+        builders take emission lists rather than sets.
+        """
+        if self._local_regions_for_remote_layers(nixl_agent_meta) is None:
+            return None
+        region_by_layer = {
+            name: region_idx
+            for region_idx, names in enumerate(self.region_members)
+            for name in names
+        }
+        group_by_layer = self.kv_cache_config.transfer_group_index_by_layer
+        fa_regions: list[int] = []
+        ssm_regions: list[int] = []
+        for names in nixl_agent_meta.region_members:
+            for name in names:
+                region_idx = region_by_layer[name]
+                spec_type = self._group_spec_types[group_by_layer[name]]
+                if _is_ssm_spec(spec_type):
+                    ssm_regions.append(region_idx)
+                else:
+                    fa_regions.append(region_idx)
+        return fa_regions, ssm_regions
