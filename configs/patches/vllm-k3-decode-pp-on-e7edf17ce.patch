+    def _expand_remote_regions_to_stage_layers(
+        self, nixl_agent_meta: NixlAgentMetadata
+    ) -> None:
+        """Rewrite a PP peer stage's per-region lists into its own layer order.
+
+        The stage registers descriptors per layer but advertises per region, and
+        the remote descriptor builders index those lists positionally. The
+        forward case gets that from ``_align_remote_regions_by_layer``, which
+        reorders into *our* layer order; here the peer is the sharded side, so
+        the order is the stage's own.
+        """
+        region_layers = nixl_agent_meta.region_members
+        assert region_layers, "Remote advertised no region_members"
+        if nixl_agent_meta.packed_member_layouts:
+            raise NotImplementedError(
+                "NixlPushConnector cannot write into a packed KV layout on a "
+                "pipeline-parallel consumer: the per-layer byte offsets are not "
+                "applied on this path."
+            )
+        per_layer = [
+            (region_idx, layer_name)
+            for region_idx, layer_names in enumerate(region_layers)
+            for layer_name in layer_names
+        ]
+        if len(per_layer) == len(region_layers):
+            # Already one layer per region: nothing to expand.
+            return
+        order = [region_idx for region_idx, _ in per_layer]
+        nixl_agent_meta.kv_caches_base_addr = [
