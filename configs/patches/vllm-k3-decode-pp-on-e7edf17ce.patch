+    def _local_regions_for_remote_layers(
+        self, nixl_agent_meta: NixlAgentMetadata
+    ) -> list[int] | None:
+        """Local regions a PP-sharded peer's stage holds, in the peer's order.
+
+        The mirror case -- this worker sharded, the peer whole -- is handled by
+        ``_align_remote_regions_by_layer`` and the PP slice branch. This is the
+        other direction: an unsharded producer facing one stage of a sharded
+        consumer, which advertises only its own layer window. Descriptor i on
+        our side must address descriptor i on theirs, so the selection follows
+        the peer's order, not ours.
+
+        Returns ``None`` when the peer holds every layer we do, which is the
+        unsharded-peer case the existing paths already cover.
+        """
+        remote_regions = nixl_agent_meta.region_members
+        if not remote_regions or not self.region_members:
+            return None
+        region_by_layer = {
+            name: region_idx
+            for region_idx, names in enumerate(self.region_members)
+            for name in names
+        }
+        remote_names = [name for names in remote_regions for name in names]
+        missing = [name for name in remote_names if name not in region_by_layer]
+        if missing:
+            raise NotImplementedError(
+                "NixlPushConnector peer advertises KV cache layers not held "
+                f"locally: {missing}. The two instances disagree about the "
+                "model, which no layer mapping can reconcile."
+            )
+        # One local region per remote *layer*. A pooled region is shared by
+        # the k-th layer of each KV-cache group *on that worker*, so a stage's
+        # pool can straddle two of ours (K3: decode stage 1 pools layers
+        # 47-50, the unsharded producer pools 44-47 and 48-51). Mapping per
+        # layer is what makes that addressable.
+        per_layer = [region_by_layer[name] for name in remote_names]
+        our_names = [name for names in self.region_members for name in names]
+        ours = [
+            region_idx
+            for region_idx, names in enumerate(self.region_members)
+            for _ in names
+        ]
+        if remote_names == our_names and per_layer == ours:
+            # The peer's regions are ours, in our order: nothing to select.
+            return None
+        return per_layer
